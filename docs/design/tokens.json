{
  "name": "TachoTime — вариант A «Кокпит»",
  "platform": "Android, 412 dp",
  "defaultTheme": "dark",
  "color": {
    "background":       { "dark": "#111315", "light": "#F4F2EE" },
    "surface":          { "dark": "#1A1D20", "light": "#FFFFFF" },
    "surface2":         { "dark": "#262A2F", "light": "#ECE9E3" },
    "line":             { "dark": "#2A2E33", "light": "#E4E0D8" },
    "text":             { "dark": "#EDEBE6", "light": "#15171A" },
    "textSecondary":    { "dark": "#A3A8AE", "light": "#5E636A" },
    "drive":            { "dark": "#F3B33D", "light": "#D48A00", "note": "Вождение, основной акцент" },
    "rest":             { "dark": "#4FBF9F", "light": "#1F8A6C" },
    "work":             { "dark": "#EE8B5A", "light": "#C9562C" },
    "available":        { "dark": "#86A8F0", "light": "#3D64C9", "note": "Готовность" },
    "warningBg":        { "dark": "#2B2415", "light": "#FFF1D1" },
    "warningText":      { "dark": "#F7D38A", "light": "#7A4B00" },
    "errorBg":          { "dark": "#2E1818", "light": "#FDE4E1" },
    "errorText":        { "dark": "#FF9C94", "light": "#A8261C" },
    "switchOff":        { "dark": "#3A3F45", "light": "#D6D2C9" },
    "scrim":            { "dark": "#070808", "light": "#8A8680", "note": "Фон под шторкой" }
  },
  "font": {
    "ui": "Onest",
    "numeric": "JetBrains Mono"
  },
  "typography": {
    "timer":        { "family": "numeric", "size": 60, "weight": 700 },
    "screenTitle":  { "family": "ui", "size": 28, "weight": 700 },
    "header":       { "family": "ui", "size": 18, "weight": 700 },
    "rowTitle":     { "family": "ui", "size": 15, "weight": 600 },
    "value":        { "family": "numeric", "size": 17, "weight": 700 },
    "body":         { "family": "ui", "size": 14, "weight": 400 },
    "caption":      { "family": "ui", "size": 13, "weight": 400 },
    "section":      { "family": "ui", "size": 13, "weight": 600, "uppercase": true, "letterSpacing": "0.08em" }
  },
  "radius": {
    "heroCard": 28,
    "card": 24,
    "modeButton": 20,
    "button": 18,
    "badge": 16,
    "icon": 14,
    "chip": 8
  },
  "spacing": {
    "screenPadding": 16,
    "betweenCards": [8, 16],
    "beforeSection": [24, 28],
    "cardPadding": 16
  },
  "size": {
    "minTouch": 44,
    "listRow": 56,
    "button": 56,
    "modeButton": 88,
    "progressBar": 6,
    "progressTick": [2, 14]
  },
  "limitStates": {
    "normal": "цвет режима",
    "warning": "< 30 мин до лимита — янтарная плашка (warningBg/warningText)",
    "violation": "лимит превышен — красная плашка (errorBg/errorText)"
  }
}
