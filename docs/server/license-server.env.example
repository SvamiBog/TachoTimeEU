# Сервер лицензий TachoTime — шаблон переменных окружения.
# Описание каждой переменной: docs/server/license-server.md, раздел 6.
# Настоящие значения — только в хранилище секретов хостинга, не в git.

# --- Общее ---
APP_ENV=prod                      # dev | prod
PORT=8080
DATABASE_URL=                     # секрет

# --- Токен лицензии (раздел 2) ---
LICENSE_SIGNING_KEY=              # секрет: приватный ключ Ed25519, PEM PKCS#8
LICENSE_SIGNING_KID=k1
LICENSE_PREVIOUS_PUBLIC_KEYS=     # только при смене ключа: k0:<base64>
LICENSE_ISSUER=tachotime-license
LICENSE_TTL_HOURS=168
CHALLENGE_TTL_SECONDS=300
INTEGRITY_MODE=enforce            # prod: enforce, dev: log
RATE_LIMIT_PER_INSTALL_PER_HOUR=20

# --- RevenueCat (раздел 3) ---
REVENUECAT_SECRET_KEY=            # секрет: sk_…
REVENUECAT_ENTITLEMENT_ID=premium

# --- Google Play Integrity (раздел 4) ---
ANDROID_PACKAGE_NAME=             # applicationId приложения
ANDROID_CERT_SHA256=              # SHA-256 сертификата App signing из Play Console
GOOGLE_SERVICE_ACCOUNT_JSON=      # секрет: JSON сервисного аккаунта или base64 от него
PLAY_INTEGRITY_REQUIRE_DEVICE=none  # none | basic | device

# --- Apple App Attest (раздел 5) ---
APPLE_TEAM_ID=
APPLE_BUNDLE_ID=
APPLE_APP_ATTEST_ENV=production   # prod: production, dev: development

# --- Перенос данных (раздел 7.4) ---
TRANSFER_TTL_HOURS=24
TRANSFER_MAX_BYTES=10485760

# Если файлы переноса хранятся в S3-совместимом хранилище:
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=                 # секрет
S3_SECRET_ACCESS_KEY=             # секрет
