#!/usr/bin/env sh
# Pre-commit: формат и анализ Dart-кода в затронутых пакетах.
# Включается один раз: git config core.hooksPath .githooks

set -e

staged=$(git diff --cached --name-only --diff-filter=ACMR -- '*.dart')
[ -z "$staged" ] && exit 0

# Сгенерированный код не форматируем и не проверяем.
files=$(printf '%s\n' "$staged" | grep -v '\.g\.dart$' || true)

if [ -n "$files" ]; then
  # shellcheck disable=SC2086
  if ! dart format --output=none --set-exit-if-changed $files >/dev/null; then
    echo "pre-commit: файлы не отформатированы. Запустите: dart format $files" >&2
    exit 1
  fi
fi

if printf '%s\n' "$staged" | grep -q '^packages/tacho_engine/'; then
  if grep -rnE "package:flutter|dart:ui" packages/tacho_engine/lib; then
    echo "pre-commit: tacho_engine должен оставаться чистым Dart" >&2
    exit 1
  fi
  (cd packages/tacho_engine && dart analyze --fatal-infos)
fi

if printf '%s\n' "$staged" | grep -q '^app/'; then
  (cd app && flutter analyze --fatal-infos)
fi
